# Secrets — never commit unencrypted
*.env
!*.enc.env
*.key
!*.enc.*
.env
.env.*

# SOPS / age — the private key must NEVER be in this repo
*.agekey
age-keys.txt
keys.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Ansible (Sprint 3+)
*.retry
.vault_pass

# Proxmox node baking (Sprint 4c) — rendered answer files carry a real
# root password; only the .tmpl and the placeholder-values example.toml
# are ever committed.
proxmox/answer.*.toml
!proxmox/answer.example.toml
proxmox/*.iso
proxmox/*.first-boot-hook.sh

# Local scratch
/scratch/
/tmp/

# Python
__pycache__/
*.pyc

.claude/
/docs/
CLAUDE.md
credentials.json
