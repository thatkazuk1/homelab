# Secrets — never commit unencrypted
*.env
!*.enc.env
*.key
!*.enc.*
.env
.env.*

# SOPS / age — the private key must NEVER be in this repo
*.agekey
age-keys.txt
keys.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Ansible (Sprint 3+)
*.retry
.vault_pass

# Proxmox node baking (Sprint 4c) — rendered answer files carry a real
# root password; only the .tmpl and the placeholder-values example.toml
# are ever committed.
proxmox-node-baking/answer.*.toml
!proxmox-node-baking/answer.example.toml
proxmox-node-baking/*.iso
proxmox-node-baking/*.first-boot-hook.sh

# OpenTofu / Terraform (Sprint 7+, conditional)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Local scratch
/scratch/
/tmp/

# Python
__pycache__/
*.pyc

.claude/
/docs/
CLAUDE.md
credentials.json
