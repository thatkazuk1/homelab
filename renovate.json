{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "dependencyDashboard": false,
  "schedule": ["before 4am on Monday"],
  "timezone": "Africa/Lagos",
  "docker-compose": {
    "managerFilePatterns": ["/^stacks/[^/]+/compose\\.ya?ml$/"]
  },
  "dockerfile": {
    "managerFilePatterns": ["/^handbook/Dockerfile$/"]
  },
  "ignorePaths": [
    "stacks/komodo/**",
    "stacks/komodo-periphery/**",
    "stacks/forgejo/**",
    "stacks/forgejo-runner/**"
  ],
  "postUpgradeTasks": {
    "commands": ["python3 scripts/generate-stack-pages.py"],
    "fileFilters": ["handbook/docs/stacks/**", "handbook/mkdocs.yml"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["update:major"]
    },
    {
      "groupName": "postgres",
      "matchPackageNames": ["/postgres/"]
    },
    {
      "description": "SparkyFitness frontend and server must run the same version, so bump them in one PR.",
      "groupName": "sparkyfitness",
      "matchPackageNames": ["codewithcj/sparkyfitness", "codewithcj/sparkyfitness_server"]
    },
    {
      "description": "Paused until upstream has a stable release. Upstream uses manual SQL migrations.",
      "matchPackageNames": ["ghcr.io/svenger87/kinboard"],
      "enabled": false
    }
  ]
}
